# Everything a spike *builds* is ignored; everything a spike *is* stays tracked.
# The tracked set is the four probe sources, the S2 mini Next app, setup.sh, the
# rendered WAV, and README.md — enough to rebuild every number in the report.

# SEA binaries, bundles, blobs, embedded asset maps (~460 MB)
.artifacts/
node_modules/

# S2 — Next build output
s2-export/.next/
s2-export/out/
s2-export/next-env.d.ts

# S3 — frozen interpreter (~800 MB), HF weights (~1.6 GB), and the scratch files
# setup.sh writes on every run. `evidence/` is deliberately NOT ignored: the
# rendered WAV is the proof the spike passed.
s3-tts-no-python/python*/
s3-tts-no-python/cache/
s3-tts-no-python/fakehome/
s3-tts-no-python/out/
s3-tts-no-python/*.tar.gz
s3-tts-no-python/req*.json
s3-tts-no-python/resp*.json

# S9 — Windows runtime round: frozen interpreter (~510 MB), its archive, the
# scratch caches the probes fill, and the local node_modules for the harnesses.
# `evidence/` stays tracked: the measured package sets ARE the finding.
s9-windows-runtime/python/
s9-windows-runtime/*.tar.gz
s9-windows-runtime/cache/
s9-windows-runtime/emptycache/
s9-windows-runtime/emptyhf/
s9-windows-runtime/fakehome/
s9-windows-runtime/out/
s9-windows-runtime/extract-test/
s9-windows-runtime/*-names.txt
s9-windows-runtime/*-norm.txt
s9-windows-runtime/win-full.txt
s9-windows-runtime/package.json
s9-windows-runtime/bun.lock
s9-windows-runtime/darwin-*.txt
s9-windows-runtime/linux-out/
