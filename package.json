{
  "name": "vidcom-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:agent-kit": "bun run --cwd packages/agent-kit build",
    "build:runtime-archives": "node scripts/build-runtime-archives.mjs",
    "start": "next start",
    "cli": "node packages/cli/bin/vidcom.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:boundaries": "node scripts/verify-import-boundaries.mjs",
    "test:golden": "vitest run tests/golden tests/mcp/golden",
    "test:mcp-catalogue": "vitest run tests/contracts/tool-schema-catalogue.test.ts",
    "test:mcp-contract": "vitest run tests/mcp/ci-guards.test.ts tests/mcp/contract-matrix.test.ts tests/mcp/negative-contract-matrix.test.ts tests/mcp/revision-pin.test.ts tests/core/write-authority.test.ts tests/mcp/registry.test.ts tests/mcp/legacy-transport.test.ts tests/mcp/modern-transport.test.ts tests/e2e/mcp-stdio-host.test.ts",
    "test:runtime-smoke": "node scripts/verify-next-runtime.mjs",
    "test:schema-drift": "node scripts/verify-schema-drift.mjs",
    "test:spec-paths": "node scripts/verify-spec-test-paths.mjs",
    "test:agent-kit": "node packages/agent-kit/scripts/build.mjs && git diff --exit-code -- packages/agent-kit/CLAUDE.md packages/agent-kit/src/generated-bundle.ts",
    "spike:process-supervision": "node spikes/phase-3-checklist-gate/s1e-cross-platform-supervision.mjs",
    "test:vieneu-sidecar": "node scripts/verify-vieneu-sidecar.mjs",
    "test:vieneu-real": "vitest run tests/adapter/tts-vieneu.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test:browser-session": "vitest run tests/frontend/browser-session.test.ts tests/frontend/editing-experience-browser.test.ts tests/frontend/preview-buffer-browser.test.ts tests/frontend/caption-runtime-browser.test.ts tests/frontend/timeline-thumbnail-browser.test.ts tests/frontend/cookie-matrix.test.ts tests/adapter/remote-asset-browser.test.ts",
    "build:artifact": "node scripts/build-artifact.mjs",
    "build:release-media": "node scripts/build-release-media.mjs",
    "test:packaged-smoke": "node scripts/packaged-smoke/run.mjs"
  },
  "dependencies": {
    "@alvin0/http-driver": "^0.4.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@hyperframes/core": "^0.7.86",
    "@hyperframes/parsers": "0.7.86",
    "@hyperframes/player": "^0.7.86",
    "@hyperframes/sdk": "^0.7.86",
    "@hyperframes/studio-server": "^0.7.86",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "hono": "4.12.33",
    "hyperframes": "0.7.86",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.16.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tailwindcss/postcss": "^4",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "postject": "1.0.0-alpha.6",
    "puppeteer-core": "25.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "node-pty",
    "sharp",
    "unrs-resolver"
  ]
}
